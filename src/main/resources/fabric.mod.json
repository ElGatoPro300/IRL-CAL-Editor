{
    "schemaVersion": 1,
    "id": "irlcal_editor",
    "version": "${version}",
    "name": "IRL CAL Editor",
    "description": "a lighting graphics engine created specifically for animation",
    "authors": [
        "ElGatoPro300, Qualet"
    ],
    "contact": {
        "homepage": "https://discord.gg/MAHVQBSce6"
    },
    "license": "MIT",
    "icon": "assets/cal/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "elgatopro300.cal_lights.CALLights"
        ],
        "client": [
            "elgatopro300.cal_lights.CALLightsClient"
        ]
    },
    "mixins": [
        "cal.mixins.json",
        {
            "config": "cal.client.mixins.json",
            "environment": "client"
        }
    ],
    "jars": [
        {
            "file": "META-INF/jars/irl-core-1.1.5-1.21.1.jar"
        }
    ],
    "depends": {
        "fabricloader": ">=0.19.0",
        "minecraft": "~1.21.1",
        "java": ">=21",
        "fabric-api": "*",
        "irl-core": "*"
    },
    "suggests": {
        "irlite": "*"
    }
}
